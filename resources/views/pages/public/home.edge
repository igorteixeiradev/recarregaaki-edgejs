@layout.app({ title: "Home" })
  @slot('meta')
    <meta
      name="description"
      content="Bem-vindo à Recarregaaki, a sua plataforma de recargas digitais em Angola."
    />
  @endslot
  
  @slot('main')
    @include('partials/navbar')
    <div class=" max-w-7xl  mx-auto lg:px-0 px-4">

      <section
        class=" mx-auto flex w-full flex-col-reverse items-center justify-between gap-10 md:flex-row md:gap-0 mb-5"
      >
        <div class="flex flex-col items-center text-center md:items-start md:text-left">
          <a
            class="mt-10 mb-6 flex items-center space-x-2 rounded-full border border-green-600 px-4 py-2 pr-1.5 text-xs text-green-600 transition hover:bg-green-50 dark:hover:bg-green-900/20"
          href="{{route("web.shop")}}"
          >
            <span>Recargas instantâneas com segurança.</span>
            <span class="flex size-6 items-center justify-center rounded-full bg-green-600 p-1">
              <svg width="14" height="11" viewBox="0 0 16 13" fill="none">
                <path
                  d="M1 6.5h14M9.5 1 15 6.5 9.5 12"
                  stroke="#fff"
                  strokeWidth="1.5"
                  strokeLinecap="round"
                  strokeLinejoin="round"
                />
              </svg>
            </span>
          </a>

          <h1
            class="mb-4 text-4xl leading-tight
 font-extrabold tracking-tight text-gray-900 md:text-5xl lg:text-5xl dark:text-white"
          >
            Recarregue os seus <br class="hidden md:block" />
            <span class="bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] bg-clip-text text-transparent">
              jogos e aplicativos
                </span>
            <br class="hidden md:block" />
            connosco
          </h1>

          <p class="text-lg font-normal text-gray-900 lg:text-start lg:text-xl dark:text-white">
            Temos pacotes do Free Fire, Netflix, TikTok e muito mais em poucos segundos, sem
                complicação e 100% seguro.
          </p>

          <div class="mt-8 flex w-full flex-col items-stretch gap-4 sm:flex-row sm:items-center sm:gap-3">
            <a
              class="flex w-full items-center justify-center space-x-2 rounded-full bg-white bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] px-6 py-3 pr-2.5 text-center text-sm font-semibold text-white transition-all duration-200 hover:bg-green-700 hover:opacity-90 active:scale-95 sm:w-auto"
              href="{{route("web.shop")}}"
            >
              <span>Ver opções na loja</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path
                  d="M4.821 11.999h13.43m0 0-6.714-6.715m6.715 6.715-6.715 6.715"
                  stroke="#fff"
                  strokeWidth="1.8"
                  strokeLinecap="round"
                  strokeLinejoin="round"
                />
              </svg>
            </a>
@if(auth.isAuthenticated)
  
                
                @else
                  <a href="{{route("auth.register.view")}}"
                    class="w-full rounded-full bg-white bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] px-5 py-3 text-center text-sm font-semibold text-white transition-all duration-200 hover:bg-green-200 hover:opacity-90 active:scale-95 sm:w-auto dark:bg-green-900/30 dark:hover:bg-green-800/50"
                  >
                    Criar conta grátis
                      </a>
                @end
          </div>
        </div>

        <div class="hidden w-full md:block">
          <img class="w-full rounded-2xl object-contain" src="images/4.png" alt="Imagem do hero" />
        </div>
      </section>

      @if(refills.length > 0)
        <div class="mb-5 grid grid-cols-2 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      @each(refill in refills)
        @!component('components/card', { id:refill.id, image:refill.image,title:refill.name,category:refill.category.name })
      @end
        </div>
      @else
      <h2 class="text-2xl text-center py-10 dark:text-white"> Nenhuma recarga encontrada </h2>
      @end
    
    </div>

