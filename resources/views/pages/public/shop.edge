@slot('main')
  @include('partials/navbar')
  <div class="py-10 max-w-7xl mx-auto lg:px-0 px-4">
    <div class="mb-5">
      <h2
      class="text-start text-4xl leading-tight font-extrabold tracking-tight text-gray-900 md:text-5xl lg:text-5xl dark:text-white mb-5">
      Loja
      </h2>
      <section>
        
        <div >
          <form action="  {{route('web.shop')}}  " method="get">
            <div class="flex shadow-xs rounded-base -space-x-0.5">
              <label for="search-dropdown" class="block mb-2.5 text-sm font-medium text-heading sr-only ">Search</label>
                <button id="dropdown-button" data-dropdown-toggle="dropdown" type="button"   class="inline-flex items-center shrink-0 z-10 text-body bg-neutral-secondary-medium border border-default-medium hover:bg-neutral-tertiary-medium hover:text-heading font-medium leading-5 rounded-s-base text-sm px-4 py-2.5 ">
                  <svg class="w-4 h-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.143 4H4.857A.857.857 0 0 0 4 4.857v4.286c0 .473.384.857.857.857h4.286A.857.857 0 0 0 10 9.143V4.857A.857.857 0 0 0 9.143 4Zm10 0h-4.286a.857.857 0 0 0-.857.857v4.286c0 .473.384.857.857.857h4.286A.857.857 0 0 0 20 9.143V4.857A.857.857 0 0 0 19.143 4Zm-10 10H4.857a.857.857 0 0 0-.857.857v4.286c0 .473.384.857.857.857h4.286a.857.857 0 0 0 .857-.857v-4.286A.857.857 0 0 0 9.143 14Zm10 0h-4.286a.857.857 0 0 0-.857.857v4.286c0 .473.384.857.857.857h4.286a.857.857 0 0 0 .857-.857v-4.286a.857.857 0 0 0-.857-.857Z"/></svg>
                    {{ categoryId
                    ? categories.find(c => String(c.id) === categoryId)?.name
                    : 'Categorias'
                    }}
                  <svg class="w-4 h-4 ms-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
                </button>
                <div id="dropdown" class="z-10 hidden bg-neutral-primary-medium border border-default-medium rounded-base shadow-lg w-44">
                  <ul class="p-2 text-sm text-body font-medium" aria-labelledby="dropdown-button">
                    <li>
                      <a href=" {{route('web.shop')}}" class="block p-2 hover:bg-neutral-tertiary-medium hover:text-heading rounded-md"> Todas as recargas </a>
                    </li>
                    @each(category in categories)
                      <li>
                        <a href="{{ route('web.shop') }}?categoria={{ category.id }}"
                        class="block p-2 rounded-md
                        @if(category.id === categoryId)
                          bg-neutral-tertiary-medium text-heading font-semibold
                          @else
                          hover:bg-neutral-tertiary-medium hover:text-heading
                        @endif
                        ">
                        {{ category.name }}
                      </a>
                      </li>
                      
                    @end
                    
                  </ul>
                </div>
                <input type="q" id="search-dropdown" id="input-group-1" class="px-3 py-2.5 bg-neutral-secondary-medium text-heading text-sm  block w-full placeholder:text-body" placeholder="Procurar pela recarga..." required>
                  <button type="submit" class="inline-flex items-center  text-white  transition-all duration-200 shadow-xs font-medium leading-5 rounded-e-base text-sm px-4 py-2.5 focus:outline-none bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] hover:opacity-90 active:scale-95">
                  <svg class="w-4 h-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/></svg>
                    Pesquisar
                  </button>
            </div>
          </form>
        </div>
    </div>
    @if(refills.length > 0)
      <div class="mb-5 grid grid-cols-2 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
        @each(refill in refills)
          @!component('components/card', { id:refill.id, image:refill.image,title:refill.name,category:refill.category.name })
        @end
      </div>
      <div class="mt-5">
        @each(anchor in refills.getUrlsForRange(1, refills.lastPage))
          <nav aria-label="Page navigation example" class="flex items-center space-x-4">
            <ul class="flex -space-x-px text-sm">
              <li>
                <a href="{{ anchor.url }}"
                class="flex items-center  rounded-full justify-center text-body bg-neutral-secondary-medium border border-default-medium hover:bg-neutral-tertiary-medium hover:text-heading shadow-xs font-medium leading-5 text-sm w-9 h-9 focus:outline-none">{{
                anchor.page }}</a>
              </li>
            </ul>
          </nav>
        @endeach
      </div>
      
      @else
      <h2 class="text-center text-2xl tracking-tight font-extrabold text-gray-900 dark:text-white"> Nenhuma recarga encontrada </h2>
    @end
      </section>
  </div>
