@layout.app({ title: "Dashboard" })
@slot('main')
  @sidebar()
  @slot('content')
    <h2 class="my-5 text-2xl font-semibold lg:text-3xl dark:text-white">
      Editar postagem
    </h2>
    <form class="space-y-4 md:space-y-6" action="{{route("blog.update",{id:post.id})}}?_method=PUT" method="post" encType="multipart/form-data">
      {{ csrfField() }}
      <div class="grid lg:grid-cols-3 gap-5 items-center">
        <div>
          @!component('components/label', { text: 'Titulo da postagem',name:"title" })
          <input type="text" name="title" id="title" value="{{post.title}}"
          class="bg-gray-50 border rounded-lg border-gray-300 text-gray-900  focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          placeholder="Nome da categoria" />
          
          @inputError("title")
            
            @each(message in $messages)
              <p class="mt-2.5 text-sm text-red-400 dark:text-red-500"><span class="font-medium">{{ message}}</p>
            @end
            
          @end
        </div>
        
        <div>
          @!component('components/label', { text: 'Estado da postagem',name:"isPublished" })
          <select name="isPublished"
          class="block w-full rounded-lg px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm  focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
          <option value="{{true}}" {{ post.isPublished ? 'selected' : '' }}>Activo</option>
          <option value="{{false}}" {{ !post.isPublished ? 'selected' : '' }}>Inativo</option>
            
            </select>
        </div>
        <div class="md:pt-5">
          @!component('components/label', { text: 'Imagem da postagem',name:"file_input" })
          
          <div class="flex gap-4">    <div ><input name="image"
              class="cursor-pointer bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-full focus:ring-brand focus:border-brand block w-full shadow-xs placeholder:text-body"
              aria-describedby="file_input_help" id="file_input" type="file"/>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-300" id="file_input_help">JPG, PNG, JPEG (1920x1080) </p></div>
              <img class="h-10 w-10 rounded-full object-cover" src="/{{post.image}}" alt="{{post.name}}" width="40"
          height="40" />  </div>
        </div>
      </div>
      @!component('components/label', { text: 'Descrição da postagem',name:"content" })
      <textarea id="content" rows="10" name="content"
      class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full p-3.5 shadow-xs placeholder:text-body"
      placeholder="Descriação..."> {{post.content}} </textarea>
      
      
      <button type="submit"
      class="flex w-full items-center justify-center space-x-2 rounded-full bg-white bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] px-6 py-3 p-2.5 text-center text-sm font-semibold text-white transition-all duration-200 hover:bg-green-700 hover:opacity-90 active:scale-95 sm:w-auto"">
      Actualizar postagem
      </button>
    </form>
  @end
@end
@end
@end
