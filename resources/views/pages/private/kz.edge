@layout.app({ title: "Dashboard" })
@slot('main')
  @sidebar()
  @slot('content')
    <h2 class="my-5 text-2xl font-semibold lg:text-3xl dark:text-white">
      Banco YETU - Divisas
    </h2>
    
    <div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base border border-default">
      <table class="w-full text-sm text-left rtl:text-right text-body">
        <thead class="text-sm text-body bg-neutral-secondary-soft border-b rounded-base border-default">
          <tr>
            <th scope="col" class="px-6 py-3 font-medium">
              Moeda
            </th>
            <th scope="col" class="px-6 py-3 font-medium">
              Compra
            </th>
            <th scope="col" class="px-6 py-3 font-medium">
              Venda
            </th>
            <th scope="col" class="px-6 py-3 font-medium">
              Ultima actualização
            </th>
            
          </tr>
        </thead>
        <tbody>
          @if(data)
            @each(i in data)
              <tr class="bg-neutral-primary border-b border-default">
                <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                  {{i.currencyBase}} para {{i.currencyTo}}
                </th>
                <td class="px-6 py-4">
                  {{i.buy}} Kz
                </td>
                <td class="px-6 py-4">
                  {{i.sell}} Kz
                </td>
                <td class="px-6 py-4">
                  {{ i.syncTime }}
                </td>
                
              </tr>
            @end
            @else
            <tr class="odd:bg-neutral-primary even:bg-neutral-secondary-soft border-b border-default">
              
              <th colspan="4" scope="row" scope="row"
              class="px-6 py-4 font-medium text-heading whitespace-nowrap text-center text-xl">
              <span>Nenhum dado encontrado</span>
                </th>
            </tr>
          
            
          @end
          
          
          
        </tbody>
      </table>
    </div>
    
  @end
@end
@endslot
@end
