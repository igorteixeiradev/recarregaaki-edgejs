                <td class="px-6 py-4">
                  <div class="flex items-center gap-5">
                    
                    <a href="{{ route('users.edit', { id: user.id }) }}"
                    class="font-medium text-green-700 hover:underline">Editar</a>
                    @!component('components/modal', {
