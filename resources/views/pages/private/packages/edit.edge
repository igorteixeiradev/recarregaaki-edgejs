@layout.app({ title: "Dashboard" })
@slot('main')
  @sidebar()
  @slot('content')
    <h2 class="my-5 text-2xl font-semibold lg:text-3xl dark:text-white">
      Actualizar pacote - {{pkg.name}}
    </h2>
    <form class="space-y-4 md:space-y-6" action="{{route("packages.update",{refillId:refillId, id:pkg.id})}}?_method=PUT" method="post">
      {{ csrfField() }}
      <div class="grid lg:grid-cols-3 gap-5 items-center">
        <input type="hidden" name="refillId" value="{{refillId}}" />
        <div>
          @!component('components/label', { text: 'Nome do pacote',name:"name" })
          @!component('components/input', { placeholder: 'Nome do pacote',name:"name", type:"text",value:pkg.name })
        </div>
        <div>
          @!component('components/label', { text: 'Outro nome',name:"otherName" })
          @!component('components/input', { placeholder: 'Outro nome',name:"otherName", type:"text",value:pkg.otherName })
        </div>
        <div>
          @!component('components/label', { text: 'Preço do pacote',name:"price" })
          @!component('components/input', { placeholder: 'Preço do pacote',name:"price", type:"number",value:pkg.price })
        </div>
        
        
        <div class="items-center">
          @!component('components/label', { text: 'Estado do pacote',name:"isActive" })
          @!component('components/select', { name:"isActive", options:[{value:true,label:"Ativo"},{value:false,label:"Inativo"}],value:pkg.isActive })
        </div>
        <div class="items-center">
          @!component('components/label', { text: 'Oferta especial?',name:"isSpecialOffer" })
          @!component('components/select', { name:"isSpecialOffer", options:[{value:true,label:"Sim"},{value:false,label:"Não"}],value:pkg.isSpecialOffer })
        </div>
      </div>
      <button type="submit"
      class="flex w-full items-center justify-center space-x-2 rounded-lg bg-white bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] px-6 py-3 p-2.5 text-center text-sm font-semibold text-white transition-all duration-200 hover:bg-green-700 hover:opacity-90 active:scale-95 sm:w-auto"">
      Actualizar pacote
      </button>
    </form>
  @end
@end

@end

@endslot
@end
