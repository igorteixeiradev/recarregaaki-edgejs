@layout.app({ title: "Dashboard" })
@slot('main')
  @sidebar()
  @slot('content')
    <h2 class="my-5 text-2xl font-semibold lg:text-3xl dark:text-white">
      Actualizar pacote - {{pkg.name}}
    </h2>
    <form class="space-y-4 md:space-y-6" action="{{route("packages.update",{refillId:refillId, id:pkg.id})}}?_method=PUT" method="post">
      {{ csrfField() }}
      <div class="grid lg:grid-cols-3 gap-5 items-center">
        <input type="hidden" name="refillId" value="{{refillId}}" />
        <div>
          @!component('components/label', { text: 'Nome do pacote',name:"name" })
          <input type="text" name="name" id="name" value="{{pkg.name}}"
          class="bg-gray-50 border rounded-lg border-gray-300 text-gray-900  focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          placeholder="Nome do pacote" />
          
          @inputError("name")
            
            @each(message in $messages)
              <p class="mt-2.5 text-sm text-red-400 dark:text-red-500"><span class="font-medium">{{ message}}</p>
            @end
            
          @end
        </div>
        <div>
          @!component('components/label', { text: 'Outro nome',name:"name" })
          <input type="text" name="otherName" id="otherName" value="{{pkg.otherName || ''}}"
          class="bg-gray-50 border rounded-lg border-gray-300 text-gray-900  focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          placeholder="Outro nome" />
          
          @inputError("otherName")
            
            @each(message in $messages)
              <p class="mt-2.5 text-sm text-red-400 dark:text-red-500"><span class="font-medium">{{ message}}</p>
            @end
            
          @end
        </div>
        <div>
          @!component('components/label', { text: 'Preço do pacote',name:"price" })
          <input type="text" name="price" id="price" value="{{pkg.price}}"
          class="bg-gray-50 border rounded-lg border-gray-300 text-gray-900  focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
          placeholder="Nome da categoria" />
          
          @inputError("price")
            
            @each(message in $messages)
              <p class="mt-2.5 text-sm text-red-400 dark:text-red-500"><span class="font-medium">{{ message}}</p>
            @end
            
          @end
        </div>
        
        
        <div class="items-center">
          @!component('components/label', { text: 'Estado do pacote',name:"isActive" })
          <select name="isActive"
          class="block w-full rounded-lg px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm  focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
          <option value="{{true}}" {{ pkg.isActive ? 'selected' : '' }}>Activo</option>
          <option value="{{false}}" {{ !pkg.isActive ? 'selected' : '' }}>Inativo</option>
            
            </select>
        </div>
        <div class="items-center">
          @!component('components/label', { text: 'Oferta especial?',name:"isSpecialOffer" })
          <select name="isSpecialOffer"
          class="block w-full rounded-lg px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm  focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
          <option value="{{true}}" {{ pkg.isSpecialOffer ? 'selected' : '' }}>Sim</option>
          <option value="{{false}}" {{ !pkg.isSpecialOffer ? 'selected' : '' }}>Não</option>
            
            </select>
        </div>
      </div>
      <button type="submit"
      class="flex w-full items-center justify-center space-x-2 rounded-lg bg-white bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] px-6 py-3 p-2.5 text-center text-sm font-semibold text-white transition-all duration-200 hover:bg-green-700 hover:opacity-90 active:scale-95 sm:w-auto"">
      Actualizar pacote
      </button>
    </form>
  @end
@end

@end

@endslot
@end
