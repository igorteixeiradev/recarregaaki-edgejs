@layout.app({ title: "Dashboard" })
@slot('main')
  @sidebar()
  @slot('content')
    <h2 class="my-5 text-2xl font-semibold lg:text-3xl dark:text-white">
      Adicionar pacote
    </h2>
    <form class="space-y-4 md:space-y-6" action="{{route("packages.store",{refillId:refillId})}}" method="post">
      {{ csrfField() }}
      <div class="grid lg:grid-cols-3 gap-5 items-center">
        <input type="hidden" name="refillId" value="{{refillId}}" />
        <div>
          @!component('components/label', { text: 'Nome do pacote',name:"name" })
          @!component('components/input', { placeholder: 'Nome do pacote',name:"name", type:"text" })
        </div>
        <div>
          @!component('components/label', { text: 'Outro nome',name:"otherName" })
          @!component('components/input', { placeholder: 'Outro nome',name:"otherName", type:"text" })
        </div>
        <div>
          @!component('components/label', { text: 'Preço do pacote',name:"price" })
          @!component('components/input', { placeholder: 'Preço do pacote',name:"price", type:"number" })
        </div>
        
        
        <div class="items-center">
          @!component('components/label', { text: 'Estado do pacote',name:"isActive" })
          <select name="isActive"
          class="block w-full rounded-full px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm  focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
          <option value="{{true}}">Activo</option>
          <option value="{{false}}">Inativo</option>
            
            </select>
        </div>
        <div class="items-center">
          @!component('components/label', { text: 'Oferta especial?',name:"isSpecialOffer" })
          <select name="isSpecialOffer"
          class="block w-full rounded-full px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm  focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
          <option value="{{true}}">Sim</option>
          <option value="{{false}}">Não</option>
            
            </select>
        </div>
      </div>
      <button type="submit"
      class="flex w-full items-center justify-center space-x-2 rounded-full bg-white bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] px-6 py-3 p-2.5 text-center text-sm font-semibold text-white transition-all duration-200 hover:bg-green-700 hover:opacity-90 active:scale-95 sm:w-auto"">
      Adicionar pacote
      </button>
    </form>
  @end
