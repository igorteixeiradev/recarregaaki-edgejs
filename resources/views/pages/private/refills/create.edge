@layout.app({ title: "Dashboard" })
@slot('main')
  @sidebar()
  @slot('content')
    <h2 class="my-5 text-2xl font-semibold lg:text-3xl dark:text-white">
      Adicionar recarga
    </h2>
    <form class="space-y-4 md:space-y-6" action="{{route("refills.store")}}" method="post" encType="multipart/form-data">
      {{ csrfField() }}
      <div class="grid lg:grid-cols-3 gap-5 items-center">
        <div>
          @!component('components/label', { text: 'Nome da recarga',name:"name" })
          @!component('components/input', { placeholder: 'Nome da recarga',name:"name", type:"text" })
        </div>
        <div>
          @!component('components/label', { text: 'Outro nome',name:"otherName" })
          @!component('components/input', { placeholder: 'Outro nome',name:"otherName", type:"text" })
        </div>
        <div class="items-center">
          @!component('components/label', { text: 'Categoria da recarga',name:"categoryId" })
          @!component('components/select', { name:"categoryId", options: categories.map(category => ({
          value: category.id,
          label: category.name,
          })) })
          
        </div>
        <div>
          @!component('components/label', { text: 'Estado da recarga',name:"isActive" })
          @!component('components/select', { name:"isActive", options:[{value:true,label:"Ativo"},{value:false,label:"Inativo"}] })
        </div>
        <div>
          @!component('components/label', { text: 'Imagem da recarga',name:"image" })
          @!component('components/input-file', { name:"image" })
          
          
        </div>
      </div>
      @!component('components/label', { text: 'Descrição da recarga',name:"description" })
      @!component('components/textarea', { placeholder: 'Descrição da recarga...',name:"description" })
      
      
      
      
      @!component('components/button', { text: 'Adicionar recarga'})
      
    </form>
  @end
@end

@end

