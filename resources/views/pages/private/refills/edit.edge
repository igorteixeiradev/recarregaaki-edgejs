@layout.app({ title: "Dashboard" })
@slot('main')
@sidebar()
@slot('content')
<h2 class="my-5 text-2xl font-semibold lg:text-3xl dark:text-white">
    Actualizar recarga - {{refill.name}}
</h2>
<form class="space-y-4 md:space-y-6" action="{{route("refills.update", {id:refill.id})}}?_method=PUT" method="post"
    encType="multipart/form-data">
    {{ csrfField() }}
    <div class="grid lg:grid-cols-3 gap-5 items-center">
        <div>
            @!component('components/label', { text: 'Nome da recarga',name:"name" })
            <input type="text" name="name" id="name" value="{{refill.name}}"
                class="bg-gray-50 border rounded-full border-gray-300 text-gray-900  focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                placeholder="Nome da categoria" />

            @inputError("name")

            @each(message in $messages)
            <p class="mt-2.5 text-sm text-red-400 dark:text-red-500"><span class="font-medium">{{ message}}</p>
            @end

            @end
        </div>
        <div class="items-center">
            @!component('components/label', { text: 'Categoria da recarga',name:"categoryId" })
            <select name="categoryId"
                class="block w-full rounded-full px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm  focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
                @each(category in categories)
                <option value="{{category.id}}" {{ category.id===refill.categoryId ? 'selected' : '' }}>
                    {{category.name}} </option>
                @end


            </select>
        </div>
        <div>
            @!component('components/label', { text: 'Estado da recarga',name:"isActive" })
            <select name="isActive"
                class="block w-full rounded-full px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm  focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
                <option value="{{true}}" {{ refill.isActive ? 'selected' : '' }}>Activo</option>
                <option value="{{false}}" {{ !refill.isActive ? 'selected' : '' }}>Inativo</option>

            </select>
        </div>
        <div>
            @!component('components/label', { text: 'Imagem da recarga',name:"file_input" })


            <div class="flex gap-4">
                <div><input name="image"
                        class="cursor-pointer bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-full focus:ring-brand focus:border-brand block w-full shadow-xs placeholder:text-body"
                        aria-describedby="file_input_help" id="file_input" type="file">
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-300" id="file_input_help">JPG, PNG, JPEG</p>
                </div>
                <img class="h-10 w-10 rounded-full object-cover" src="/{{refill.image}}" width="500" height="500" />
            </div>
        </div>
    </div>
    @!component('components/label', { text: 'Descrição da recarga',name:"description" })
    <textarea id="description" rows="10" name="description"
        class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full p-3.5 shadow-xs placeholder:text-body"
        placeholder="">{{refill.description}}</textarea>


    <button type="submit"
        class="flex w-full items-center justify-center space-x-2 rounded-full bg-white bg-linear-to-r from-violet-500 via-[#9938CA] to-[#E0724A] px-6 py-3 p-2.5 text-center text-sm font-semibold text-white transition-all duration-200 hover:bg-green-700 hover:opacity-90 active:scale-95 sm:w-auto"">
  Actualizar recarga
</button>
</form>
@end
@end

@end

@endslot
@end