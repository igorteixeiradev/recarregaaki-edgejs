                  </td>
                  <td class="px-6 py-4">
                    {{payment.package.price}} Kz
                  </td>
                  
                  <td class="px-6 py-4">
                    @if(payment.status === 'PAID')
                      <span class="text-green-600 font-semibold">{{ payment.status }}</span>
