<div
  class="w-full rounded-xl border border-gray-200 bg-white p-3 shadow-2xl transition duration-300 hover:-translate-y-0.5 dark:border-gray-700 dark:bg-gray-900">
  <div>
    <a href="{{ route('web.show', {  id  }) }}">
      <img class="h-52 w-full rounded-md" src="/{{ image }}" width="500" height="500" alt="{{ title }} " />
    </a>
    <a href="{{ route('web.show', {  id  }) }}">
      <h3 class="mt-3 text-base font-semibold text-slate-900 dark:text-white">
        {{ title }}
      </h3>
    </a>

    <p class="mt-1 line-clamp-1 font-medium text-green-600 lg:text-xs dark:text-green-400">
      {{ category }}
    </p>
  </div>
</div>